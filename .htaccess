<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Canonical Redirect: Enforce HTTPS and non-www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L,NE]

    # 2. Redirect Trailing Slashes If Not A Directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.+)/+$
    RewriteRule ^ https://%{HTTP_HOST}%1 [R=301,L,NE]

    # 3. Prevent direct public access to /public/ in URL
    RewriteCond %{THE_REQUEST} \s/public/([^\s]*) [NC]
    RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]

    # 4. Internally route all requests into public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
